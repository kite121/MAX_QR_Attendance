# Copy to .env.production beside compose.production.yaml. Never commit the copy.
# Generate a URL-safe hex password, for example: openssl rand -hex 24
POSTGRES_PASSWORD=
# Generate a separate secret of at least 32 characters: openssl rand -hex 32
JWT_SECRET=
# The bot access token that successfully authenticates GET /me; never paste it in chat.
MAX_BOT_TOKEN=
MAX_BOT_NAME=t349_hakaton_max_bot

# Leave blank for the first signed MAX login. Fill with the human user's numeric
# MAX ID (not the bot's /me ID), then restart backend to appoint that teacher.
BOOTSTRAP_TEACHER_MAX_USER_ID=
BOOTSTRAP_TEACHER_NAME=Тестовый преподаватель
BOOTSTRAP_GROUP_NAME=Тестовая группа
